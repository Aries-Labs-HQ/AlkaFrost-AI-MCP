# The variables AlkaFrost reads. The server takes them from its environment (set them
# in your MCP client's config, e.g. its "env" block); it does not load a .env file itself.
#
# Your SUBFROST API key — get one at https://api.subfrost.io/auth/signup?ref=73084DAD
# (the link gives you 50% off your first month; we earn nothing from it). Sent only as the
# x-subfrost-api-key header, never in a URL.
SUBFROST_API_KEY=replace-me

# Optional gateway overrides (default: mainnet JSON-RPC; REST is derived from it):
# SUBFROST_RPC=https://mainnet.subfrost.io/v4/jsonrpc
# SUBFROST_REST=https://mainnet.subfrost.io/v4/api

# Optional: where your local incident log lives (default: data/incidents.jsonl)
# ALKAFROST_INCIDENTS_PATH=/path/to/incidents.jsonl
